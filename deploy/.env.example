# Copy to .env on each server and fill in; never commit it.
# Lines marked SECRET are typed in by the owner on the server itself.
# Wrap values containing $, # or spaces in single quotes.

## Things Cloud account (same on every node)
# SECRET
THINGS_USERNAME=
# SECRET
THINGS_PASSWORD=
# SECRET: the same API_KEY as on Fly (backup links are signed with it)
API_KEY=
THINGS_TIMEZONE=America/New_York
# SECRET, only if Fly had CALDAV_PASSWORD set (else CalDAV uses API_KEY)
#CALDAV_PASSWORD=
# true for cutover step 3, false from step 5 on
CALDAV_READ_ONLY=true

## This node
# us1 | us2 | us3 | ro
NODE_NAME=us1
# This node's address on the private mesh (WireGuard or Tailscale)
MESH_IP=10.77.0.1

## rqlite
# Raft addresses of the three US voters
RQLITE_JOIN=10.77.0.1:4002,10.77.0.2:4002,10.77.0.3:4002
# US nodes: -bootstrap-expect=3    Romania: -raft-non-voter=true
RQLITE_ROLE_FLAG=-bootstrap-expect=3
# The app talks to its own node: http://<MESH_IP>:4001
DAV_RQLITE_URL=http://10.77.0.1:4001
DAV_RQLITE_USER=things
# SECRET: same on every node, and in rqlite-auth.json
DAV_RQLITE_PASSWORD=
# Default true: keep CalDAV writable on a node that loses the rqlite leader
#DAV_LOCAL_FALLBACK=true

## Backups in Cloudflare R2 (same on every node)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=things-backups
# SECRET
R2_ACCESS_KEY_ID=
# SECRET
R2_SECRET_ACCESS_KEY=

## Cloudflare Tunnel (same token on every node)
# SECRET
TUNNEL_TOKEN=

## Image: built locally by default, or e.g. ghcr.io/zhehanzhang/things-cloud-mcp:<tag>
#APP_IMAGE=things-cloud-mcp:local
